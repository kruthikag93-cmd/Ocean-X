from pathlib import Path
import numpy as np
from PIL import Image
import matplotlib.pyplot as plt

# ---------------------------------------------------------
# Ocean X - Step 1
# Read one AI4Shipwrecks sonar image + its ground-truth mask
# ---------------------------------------------------------

# Run this script from inside the AI4Shipwrecks folder.
image_path = "train/images/DM_Wilson_03.png"
label_path = "train/labels/DM_Wilson_03.png"
# 1. Load the sonar image as grayscale
sonar = Image.open(image_path).convert("L")

# 2. Load the label.
# AI4Shipwrecks uses:
# 0 = other/background
# 1 = shipwreck
label = Image.open(label_path)

# The official helper code uses the first channel.
label_array = np.array(label)[:, :, 0] if np.array(label).ndim == 3 else np.array(label)

# 3. Convert the label into a simple binary mask.
# We use > 0 because the dataset stores the foreground as 1.
mask = (label_array > 0).astype(np.uint8)

# 4. Print what the computer sees.
print("----- Ocean X: First Experiment -----")
print("Image size:", sonar.size)
print("Sonar minimum pixel value:", np.array(sonar).min())
print("Sonar maximum pixel value:", np.array(sonar).max())
print("Label values:", np.unique(label_array))
print("Number of shipwreck pixels:", mask.sum())
print("Shipwreck pixel percentage:", round(mask.mean() * 100, 2), "%")

# 5. Display:
#    A = original sonar image
#    B = ground-truth mask
#    C = sonar with the mask outlined
sonar_array = np.array(sonar)

# Find the boundary of the mask using neighboring pixels.
up = np.roll(mask, 1, axis=0)
down = np.roll(mask, -1, axis=0)
left = np.roll(mask, 1, axis=1)
right = np.roll(mask, -1, axis=1)
boundary = (mask == 1) & ((up == 0) | (down == 0) | (left == 0) | (right == 0))

overlay = sonar_array.copy()
overlay[boundary] = 255

# ---------------------------------------------------------
# VISUALIZATION
# ---------------------------------------------------------

sonar_array = np.array(sonar)

# Convert label to a binary mask
mask = (label_array == 1).astype(np.uint8)

# Convert:
# 0 -> 0   (black)
# 1 -> 255 (white)
mask_display = mask * 255

# Print useful information in the terminal
print("\n----- LABEL INFORMATION -----")
print("Unique label values:", np.unique(label_array))
print("Mask shape:", mask.shape)
print("Shipwreck pixels:", int(mask.sum()))
print("Shipwreck percentage:", round(mask.mean() * 100, 2), "%")

# Create figure
fig, axes = plt.subplots(1, 3, figsize=(12, 8))

# ---------------------------------------------------------
# 1. ORIGINAL SONAR
# ---------------------------------------------------------

axes[0].imshow(sonar_array, cmap="gray")
axes[0].set_title("Original Sonar")
axes[0].axis("off")

# ---------------------------------------------------------
# 2. GROUND TRUTH
# ---------------------------------------------------------

axes[1].imshow(mask_display, cmap="gray", vmin=0, vmax=255)
axes[1].set_title("Ground Truth\nWhite = Shipwreck")
axes[1].axis("off")

# ---------------------------------------------------------
# 3. OVERLAY
# ---------------------------------------------------------

axes[2].imshow(sonar_array, cmap="gray")

# Show the ground truth in red
axes[2].imshow(
