from PIL import ImageFilter

# Convert crop back to PIL image
crop_image = Image.fromarray(sonar_crop)

# Apply a small Gaussian blur
smoothed = crop_image.filter(ImageFilter.GaussianBlur(radius=1))

# Convert to numpy
smoothed_array = np.array(smoothed)

# Contrast stretching
low = np.percentile(smoothed_array, 2)
high = np.percentile(smoothed_array, 98)

enhanced = np.clip(
    (smoothed_array - low) * 255 / (high - low),
    0,
    255
).astype(np.uint8)

# Display comparison
plt.figure(figsize=(15, 5))

plt.subplot(1, 3, 1)
plt.imshow(sonar_crop, cmap="gray")
plt.title("Original Sonar")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(smoothed_array, cmap="gray")
plt.title("Noise Reduced")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(enhanced, cmap="gray")
plt.title("Contrast Enhanced")
plt.axis("off")

