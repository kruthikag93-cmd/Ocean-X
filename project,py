from pathlib import Path
from PIL import Image
import numpy as np

image_folder = Path("train/images")
label_folder = Path("train/labels")

found = False

for image_file in sorted(image_folder.glob("*.png")):

    label_file = label_folder / image_file.name

    if not label_file.exists():
        continue

    image = Image.open(image_file)
    label = Image.open(label_file)

    image_array = np.array(image)
    label_array = np.array(label)

    # If label has multiple channels, use first channel
    if label_array.ndim == 3:
        label_array = label_array[:, :, 0]

    unique_values = np.unique(label_array)

    shipwreck_pixels = np.sum(label_array == 1)

    if shipwreck_pixels > 0:

        print("\nFOUND SHIPWRECK!")
        print("Image:", image_file.name)
        print("Image size:", image.size)
        print("Label size:", label.size)
        print("Label values:", unique_values)
        print("Shipwreck pixels:", int(shipwreck_pixels))
        print(
            "Shipwreck percentage:",
            round(shipwreck_pixels / label_array.size * 100, 2),
            "%"
        )

        found = True
        break

if not found:
    print("\nNo shipwreck labels were found.")

print("\n========== SHIPWRECK ANALYSIS ==========")

# Find coordinates of shipwreck pixels
shipwreck_y, shipwreck_x = np.where(label_array == 1)

# Bounding box
x_min = shipwreck_x.min()
x_max = shipwreck_x.max()
y_min = shipwreck_y.min()
y_max = shipwreck_y.max()

# Width and height
width = x_max - x_min + 1
height = y_max - y_min + 1

print("Bounding box:")
print("X min:", x_min)
print("X max:", x_max)
print("Y min:", y_min)
print("Y max:", y_max)

print("\nShipwreck width:", width, "pixels")
print("Shipwreck height:", height, "pixels")

# Area
shipwreck_area = len(shipwreck_x)
total_area = label_array.shape[0] * label_array.shape[1]

print("\nShipwreck pixels:", shipwreck_area)
print("Total image pixels:", total_area)

print(
    "Shipwreck area percentage:",
    round(shipwreck_area / total_area * 100, 2),
    "%"
)
