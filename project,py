from scipy import ndimage

# Use the cropped sonar
threshold = 150

binary = (sonar_crop > threshold)

# Find connected bright regions
labeled, number_of_objects = ndimage.label(binary)

print("\n========== CONNECTED COMPONENT ANALYSIS ==========")
print("Number of bright regions:", number_of_objects)

# Measure each region
objects = ndimage.find_objects(labeled)

for i, obj in enumerate(objects):

    if obj is None:
        continue

    y_slice, x_slice = obj

    width = x_slice.stop - x_slice.start
    height = y_slice.stop - y_slice.start

    area = np.sum(labeled[obj] == i + 1)

    # Ignore tiny regions
    if area > 100:

        print(
            "Object", i + 1,
            "| Area:", area,
            "| Width:", width,
            "| Height:", height
        )

# Display
plt.figure(figsize=(10, 6))

plt.imshow(binary, cmap="gray")
plt.title("Connected Bright Regions")
plt.axis("off")

plt.show()

# ==========================================
# COMPARE BRIGHT REGIONS WITH GROUND TRUTH
# ==========================================

ground_truth = (label_crop == 1)

best_iou = 0
best_object = None

for i in range(1, number_of_objects + 1):

    candidate = (labeled == i)

    intersection = np.logical_and(
        candidate,
        ground_truth
    ).sum()

    union = np.logical_or(
        candidate,
        ground_truth
    ).sum()

    if union == 0:
        continue

    iou = intersection / union

    if iou > best_iou:
        best_iou = iou
        best_object = i

print("\n========== THRESHOLD DETECTOR EVALUATION ==========")

print("Best matching object:", best_object)
print("Best IoU:", round(best_iou, 4))